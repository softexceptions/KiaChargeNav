[Unit]
Description=KiaChargeNav FastAPI Backend
After=network.target

[Service]
Type=simple
User=kiachargenav
Group=kiachargenav
WorkingDirectory=/opt/kiachargenav/backend
Environment="PATH=/opt/kiachargenav/backend/.venv/bin"
ExecStart=/opt/kiachargenav/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
